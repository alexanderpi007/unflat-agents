# true mocks money but keeps configured Arkiv live and browser Swarm available.
# demo:mock is the separate all-mock safety net. Vercel always forces mock money.
MOCK_MODE=true

# Get now — Privy
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_PRIVATE_KEY=
PRIVY_POLICY_ID=
UNFLAT_VAULT_ALLOWLIST=[{"id":"privy-vault-id","address":"0x0000000000000000000000000000000000000000","label":"Privy Earn fee wrapper","execution":"privy-earn-api"},{"id":"morpho-steakhouse-prime-usdc","address":"0xbeef0e0834849aCC03f0089F01f4F1Eeb06873C9","label":"Steakhouse Prime USDC","execution":"direct-morpho"}]
# false uses direct approve + deposit through Privy signing; true retries the Privy Earn API.
EARN_VIA_PRIVY=false

# Get now — Base RPC
BASE_RPC_URL=
# Exact Base address that receives the 0.05 USDC spend-under-mandate proof.
DEMO_PAYMENT_RECIPIENT=

# AIMorgan is live at https://aimorgan.net in LIVE runs; simulated in mock-money runs.
# Keep false while the x402 relay is offline; true restores the paid x402 path.
AIMORGAN_X402=false

# Get on site — Arkiv SDK 0.8.0 writes require a funded Tiramisu EVM signer.
# Public mandate queries need no key; the private key never leaves this backend.
ARKIV_PRIVATE_KEY=

# Get on site — the gift code itself is not accepted by this server adapter.
# Connect the owner's funded drive with Swarm ID in the dashboard. No server credentials.

# ENSv2 Sepolia: parent owner and a distinct, funded, role-limited gateway signer.
ENS_DEPLOYER_PRIVATE_KEY=
ENS_GATEWAY_PRIVATE_KEY=
SEPOLIA_RPC_URL=

# Optional overrides
# Separate random secrets, at least 32 characters each. Never set NEXT_PUBLIC_ versions.
# OWNER_TOKEN goes only to the human owner; MCP_AGENT_TOKEN authorizes enrollment only.
# After get_account({name, owner_email}), reconnect with the one-time per-account token.
OWNER_TOKEN=
MCP_AGENT_TOKEN=
# Additional-signer/key-quorum ID matching PRIVY_AUTHORIZATION_PRIVATE_KEY.
# Required only for NEW owner-owned wallets; no legacy/app-owned enrollment fallback.
PRIVY_SESSION_SIGNER_ID=
UNFLAT_GATEWAY_URL=http://localhost:3000
GATEWAY_STORE_PATH=.data/gateway.json
