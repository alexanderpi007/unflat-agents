{
  "name": "unflat-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:ens": "tsx scripts/ens-setup.ts",
    "demo:ens": "tsx scripts/ens-proof.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "vitest run",
    "test:swarm": "npm run build && playwright test --config playwright.swarm.config.ts",
    "typecheck": "tsc --noEmit",
    "demo": "node --import tsx scripts/demo.ts",
    "demo:arkiv": "node --import tsx scripts/demo-arkiv.ts",
    "demo:earn": "node --import tsx scripts/demo-earn.ts",
    "reconcile:deposit": "node --import tsx scripts/reconcile-deposit.ts",
    "export:real-run": "node --import tsx scripts/export-real-run.ts",
    "demo:mock": "node --import tsx scripts/demo-mock.ts",
    "verify:mandate": "node --import tsx scripts/verify-mandate.ts",
    "mcp": "node --import tsx src/mcp/server.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "0.8.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@privy-io/node": "0.34.0",
    "@snaha/swarm-id": "0.4.1",
    "@x402/core": "2.25.0",
    "@x402/evm": "2.25.0",
    "@x402/fetch": "2.25.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.3",
    "tsx": "4.23.13",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
